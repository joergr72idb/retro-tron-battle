10 REM =========================================
11 REM  STANDALONE JOYSTICK TEST - SCHNEIDER CPC
12 REM  NO NETWORKING. SHOWS JOY(0) RAW + DECODED.
13 REM  SAME BIT CONVENTION AS THE REAL CLIENT:
14 REM  1=UP 2=DOWN 4=LEFT 8=RIGHT 16=FIRE1 32=FIRE2
15 REM =========================================
20 MODE 1
100 MODE 1
110 PRINT "MOVE THE JOYSTICK / PRESS FIRE."
120 PRINT "IDLE = 0 (NO BITS SET)."
130 PRINT
140 J=JOY(0)
150 GOSUB 500
160 PRINT "JOY(0) = ";J;" ";D$
170 GOTO 100
500 REM -- DECODE BITS OF J INTO DIRECTION TEXT --
510 D$=""
520 IF (J AND 1)<>0 THEN D$=D$+"UP "
530 IF (J AND 2)<>0 THEN D$=D$+"DOWN "
540 IF (J AND 4)<>0 THEN D$=D$+"LEFT "
550 IF (J AND 8)<>0 THEN D$=D$+"RIGHT "
560 IF (J AND 16)<>0 THEN D$=D$+"FIRE1 "
570 IF (J AND 32)<>0 THEN D$=D$+"FIRE2 "
580 IF D$="" THEN D$="-"
590 RETURN
