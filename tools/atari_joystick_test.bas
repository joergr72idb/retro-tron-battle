10 REM =========================================
11 REM  STANDALONE JOYSTICK TEST - ATARI XL/XE
12 REM  NO NETWORKING. SHOWS STICK(0)/STICK(1)
13 REM  RAW + DECODED, SAME BIT CONVENTION AS
14 REM  THE REAL CLIENT (STICK(JSPORT)).
15 REM =========================================
20 GRAPHICS 0:POKE 82,0
30 JSPORT=0 :REM SET TO 1 IF YOUR CONTROLLER SHOWS UP ON STICK(1)
100 POSITION 0,0:PRINT #6;"MOVE THE JOYSTICK / PRESS KEYS.       ";
110 POSITION 0,1:PRINT #6;"IDLE=15 UP=14 DOWN=13 LEFT=11 RIGHT=7 ";
120 POSITION 0,3:PRINT #6;"STICK(0) = ";STICK(0);"    ";
130 POSITION 0,4:PRINT #6;"STICK(1) = ";STICK(1);"    ";
140 ST=STICK(JSPORT):GOSUB 500
150 POSITION 0,6:PRINT #6;"STICK(JSPORT=";JSPORT;") DECODED: ";D$;"        ";
160 GOTO 100
500 REM -- DECODE BITS OF ST INTO DIRECTION TEXT --
501 REM    ACTIVE-LOW: BIT=0 MEANS PRESSED
510 D$=""
520 IF (ST AND 1)=0 THEN D$=D$+"UP "
530 IF (ST AND 2)=0 THEN D$=D$+"DOWN "
540 IF (ST AND 4)=0 THEN D$=D$+"LEFT "
550 IF (ST AND 8)=0 THEN D$=D$+"RIGHT "
560 IF D$="" THEN D$="-"
570 RETURN
