10 REM =========================================
11 REM  STANDALONE JOYSTICK TEST - NO NETWORKING
12 REM  JUST PRINTS STICK(0) AND STICK(1) LIVE
13 REM =========================================
20 GRAPHICS 0:POKE 82,0
30 POSITION 0,0:PRINT #6;"MOVE THE JOYSTICK / PRESS KEYS.";
40 POSITION 0,1:PRINT #6;"VALUES SHOULD CHANGE FROM 15.";
50 POSITION 0,3:PRINT #6;"IDLE=15 UP=14 DOWN=13 LEFT=11 RIGHT=7";
100 POSITION 0,6:PRINT #6;"STICK(0) = ";STICK(0);"    ";
110 POSITION 0,7:PRINT #6;"STICK(1) = ";STICK(1);"    ";
120 GOTO 100
