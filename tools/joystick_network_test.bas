10 REM ==========================================
11 REM  JOYSTICK + NETWORK TEST (NO GAME LOGIC)
12 REM  SAME OPEN/STATUS/INPUT PATTERN AS THE REAL
13 REM  CLIENT, TO SEE IF NETWORKING AFFECTS STICK()
14 REM ==========================================
20 GRAPHICS 0:POKE 82,0
30 DIM URL$(40),HOST$(20),PORTS$(10),A$(80)
40 HOST$="192.168.1.50" :REM <-- EDIT: GAME SERVER IP
50 PORTS$="6502"
60 URL$="N:TCP://"
70 URL$(LEN(URL$)+1)=HOST$
80 URL$(LEN(URL$)+1)=":"
90 URL$(LEN(URL$)+1)=PORTS$
100 URL$(LEN(URL$)+1)="/"
110 POSITION 0,0:PRINT #6;"CONNECTING...             ";
120 OPEN #1,12,2,URL$
130 PRINT #1;"HELLO ATARI JSTEST"
140 POSITION 0,0:PRINT #6;"CONNECTED - WATCH ROWS BELOW";
200 REM ===== MAIN LOOP: STATUS POLL + STICK READ, NO GAME LOGIC =====
210 STATUS #1,SR
220 BW=PEEK(747)*256+PEEK(746)
230 POSITION 0,2:PRINT #6;"STICK(0) = ";STICK(0);"    ";
240 POSITION 0,3:PRINT #6;"STICK(1) = ";STICK(1);"    ";
250 POSITION 0,4:PRINT #6;"BYTES WAITING = ";BW;"    ";
260 IF BW=0 THEN 210
270 INPUT #1,A$
280 POSITION 0,6:PRINT #6;"GOT: ";A$;"                         ";
290 GOTO 210
