10 REM ====================================
11 REM  RETRO TRON - APPLE II CLIENT (v1)
12 REM  SERVER DRAWS THE BOARD - THIS APPLE
13 REM  JUST STEERS, VIA FUJINET'S N: TCP
14 REM  DEVICE (AMPERSAND ROUTINES). JOY-
15 REM  STICK VIA PDL(0)/PDL(1) - ANALOG,
16 REM  NO DIGITAL STICK() ON APPLE II.
17 REM ====================================
18 REM  UNVERIFIED - NOT YET RUN ON REAL
19 REM  HARDWARE OR AN EMULATOR. BUILT FROM
20 REM  THE FUJINET WIKI'S N: DEVICE AND
21 REM  APPLESOFT-NETWORK-EXTENSIONS PAGES;
22 REM  NO WORKING TCP CODE SAMPLE EXISTED
23 REM  TO COPY FROM. EXPECT TO DEBUG ON THE
24 REM  FIRST RUN - SEE CLAUDE.MD.
25 REM ====================================
30 HOST$ = "192.168.17.158" : REM <-- EDIT: GAME SERVER IP
40 PORT$ = "6502"
50 NAME$ = "APPLE2" : REM <-- EDIT: YOUR PLAYER NAME
60 CX = 128 : REM <-- EDIT: PADDLE 0 (X) CENTER - CALIBRATE ON HARDWARE
70 CY = 128 : REM <-- EDIT: PADDLE 1 (Y) CENTER - CALIBRATE ON HARDWARE
80 DZ = 40 : REM <-- EDIT: DEADZONE AROUND CENTER - TUNE IF STEERING FEELS OFF
90 TEXT : HOME
100 REM -- LOAD THE FUJINET APPLESOFT NETWORK EXTENSIONS --
110 PRINT CHR$(4);"BLOAD /FUJI.APPLE/FUJIAPPLE"
120 CALL 16384
130 REM ===== RESTART POINT, REACHED VIA "RUN" (SEE BELOW) =====
140 TEXT : HOME : DR = 0 : RB$ = ""
150 PRINT " RETRO TRON BATTLE -"
160 PRINT " CLASSIC COMPUTING 2026"
170 PRINT " APPLE II / FUJINET EDITION - BUILD 1"
180 PRINT
190 PRINT "ENTER YOUR PIN OR PRESS RETURN:"
200 INPUT PN$
210 U$ = "N:TCP://" + HOST$ + ":" + PORT$ + "/"
220 PRINT "CONNECTING TO ";HOST$;":";PORT$
230 &NOPEN 0,12,0,U$
240 IF PN$ = "" THEN H$ = "HELLO APPLE2 " + NAME$ : GOTO 260
250 H$ = "HELLO APPLE2 " + NAME$ + " " + PN$
260 H$ = H$ + CHR$(13)
270 &NWRITE 0,H$,LEN(H$)
280 REM -- WAIT FOR "WAIT" OR "START ..." --
290 GOSUB 1000
300 IF L$ = "WAIT" THEN 290
310 REM -- "START ..." ARRIVED, WE DON'T NEED ITS FIELDS --
320 PRINT "USE JOYSTICK"
330 REM ============ MAIN LOOP - STEER + WAIT ============
340 X = PDL(0) : Y = PDL(1)
350 ND = 0
360 IF Y < CY - DZ THEN ND = 1 : REM UP
370 IF Y > CY + DZ THEN ND = 2 : REM DOWN
380 IF X < CX - DZ THEN ND = 3 : REM LEFT
390 IF X > CX + DZ THEN ND = 4 : REM RIGHT
400 IF ND = 0 OR ND = DR THEN 430
410 DR = ND
420 GOSUB 2000 : REM SEND THE NEW DIRECTION
430 &NSTATUS 0,BW,CONN,NERR
440 IF BW = 0 THEN 340
450 GOSUB 1000
460 IF LEFT$(L$,3) = "END" THEN 500
470 GOTO 340
500 REM -- GAME OVER: SHOW RESULT, THEN GRAB STATS LINE --
510 PRINT "GAME OVER"
520 PRINT L$
530 GOSUB 1000
540 PRINT L$
550 &NCLOSE 0
560 PRINT "RESTARTING..."
570 FOR DL = 1 TO 25 : FOR W = 1 TO 200 : NEXT W : NEXT DL
580 RUN
1000 REM -- READ ONE LINE (UP TO CR) INTO L$, BLOCKS UNTIL A --
1005 REM    FULL LINE ARRIVES. RB$ CARRIES LEFTOVER BYTES
1006 REM    ACROSS CALLS. NSTATUS-BEFORE-NREAD PER FUJINET
1007 REM    WIKI (NREAD ERRORS IF YOU ASK FOR MORE BYTES THAN
1008 REM    ARE ACTUALLY WAITING).
1010 CP = 0
1020 IF LEN(RB$) = 0 THEN 1080
1030 FOR I = 1 TO LEN(RB$)
1040 IF CP = 0 AND MID$(RB$,I,1) = CHR$(13) THEN CP = I
1050 NEXT I
1060 IF CP > 0 THEN 1130
1080 &NSTATUS 0,BW,CONN,NERR
1090 IF BW = 0 THEN 1080
1100 &NREAD 0,RX$,BW
1110 RB$ = RB$ + RX$
1120 GOTO 1010
1130 L$ = LEFT$(RB$,CP - 1)
1140 IF CP = LEN(RB$) THEN RB$ = "" : RETURN
1150 RB$ = MID$(RB$,CP + 1,LEN(RB$) - CP)
1160 RETURN
2000 REM -- SEND A MOVE COMMAND FOR DIRECTION DR --
2010 D$ = "MOVE U"
2020 IF DR = 2 THEN D$ = "MOVE D"
2030 IF DR = 3 THEN D$ = "MOVE L"
2040 IF DR = 4 THEN D$ = "MOVE R"
2050 D$ = D$ + CHR$(13)
2060 &NWRITE 0,D$,LEN(D$)
2070 RETURN
