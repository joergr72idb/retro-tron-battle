10 REM ====================================
11 REM  RETRO TRON - ATARI CLIENT (v4)
12 REM  SERVER DRAWS THE BOARD - THIS ATARI
13 REM  JUST STEERS. REQUIRES FUJINET N:
14 REM  JOYSTICK IN PORT 1 (OR SET JSPORT)
15 REM ====================================
20 GRAPHICS 0:POKE 82,0
30 DIM URL$(40),HOST$(20),PORTS$(10),NAME$(10),A$(80),D$(10),PIN$(10)
31 DIM AU$(80),TX$(80)
40 HOST$="192.168.17.11" :REM <-- EDIT: GAME SERVER IP
50 PORTS$="6502"
60 JSPORT=0 :REM SET TO 1 IF YOUR CONTROLLER SHOWS UP ON STICK(1)
70 NAME$="ATARIXL" :REM <-- EDIT: YOUR PLAYER NAME
80 REM ===== NEUSTART-PUNKT, WIRD UEBER "RUN" ERREICHT (SIEHE UNTEN) =====
81 GRAPHICS 0:POKE 82,0:TRAP 900:DR=0
82 REM -- ATASCII-BANNER (INVERSE BALKEN) - TITEL BLEIBT OHNE TIPPEFFEKT --
83 FOR I=1 TO 40:PRINT CHR$(160);:NEXT I
84 PRINT " RETRO TRON BATTLE -"
85 PRINT " CLASSIC COMPUTING 2026"
86 PRINT " ATARI XL / FUJINET EDITION - BUILD 18"
87 FOR I=1 TO 40:PRINT CHR$(160);:NEXT I
88 PRINT
90 REM -- BUILD THE N: URL (STOCK BASIC HAS NO "+",
91 REM    SO WE APPEND VIA STRING-ARRAY INDEXING) --
100 URL$="N:TCP://"
110 URL$(LEN(URL$)+1)=HOST$
120 URL$(LEN(URL$)+1)=":"
130 URL$(LEN(URL$)+1)=PORTS$
140 URL$(LEN(URL$)+1)="/"
145 TX$="MCP:> WELCOME TO THE GRID...":GOSUB 4000
146 TX$="MCP:> USER ENTER YOUR PIN (OR ENTER":GOSUB 4000
147 TX$="      FOR MOVEON WITHOUT):":GOSUB 4000
148 INPUT PIN$
149 IF PIN$="" THEN GOTO 165
150 TX$="MCP:> MASTER CONTROL PROGRAM SEARCH PHOTO...":GOSUB 4000
151 TX$="MCP:> DOWNLOAD PHOTO FROM FOTOFIX-SERVER -":GOSUB 4000
152 TX$="      UPLOAD TO GRID":GOSUB 4000
153 GOSUB 3000
154 FOR DL=1 TO 8:FOR W=1 TO 200:NEXT W:NEXT DL
165 TX$="MCP:> UPLOAD COMPLETED. CONNECTING GRIDSERVER "
166 TX$(LEN(TX$)+1)=HOST$
167 TX$(LEN(TX$)+1)=":"
168 TX$(LEN(TX$)+1)=PORTS$
169 GOSUB 4000
170 TRAP 900
171 OPEN #1,12,2,URL$
178 IF PIN$="" THEN PRINT #1;"HELLO ATARI ";NAME$:GOTO 195
180 PRINT #1;"HELLO ATARI ";NAME$;" ";PIN$
195 TX$="MCP:> GET READY FOR RACE. USE JOYSTICK.":GOSUB 4000
196 TX$="      WATCH ON GRID SCREEN":GOSUB 4000
200 INPUT #1,A$
210 IF A$="WAIT" THEN 200
220 REM -- "START ..." ARRIVED, WE DON'T NEED ITS FIELDS --
230 TX$="MCP:> YOU'VE GRANTED ACCESS TO THE GAME GRID":GOSUB 4000
240 TRAP 700 :REM FROM HERE, TREAT ANY HICCUP AS A GRACEFUL GAME-OVER
250 DR=0
300 REM ============ MAIN LOOP - STEER + WAIT ============
310 ST=STICK(JSPORT)
320 ND=0
330 IF ST=14 THEN ND=1 :REM UP
340 IF ST=13 THEN ND=2 :REM DOWN
350 IF ST=11 THEN ND=3 :REM LEFT
360 IF ST=7  THEN ND=4 :REM RIGHT
370 IF ND=0 OR ND=DR THEN 400
380 DR=ND
390 GOSUB 1000 :REM SEND THE NEW DIRECTION
400 STATUS #1,SR
410 BW=PEEK(747)*256+PEEK(746)
420 IF BW=0 THEN 300
430 INPUT #1,A$
440 IF A$(1,3)="END" THEN 500
450 GOTO 300
500 REM -- GAME OVER: SHOW RESULT, THEN GRAB STATS LINE --
505 TX$="MCP:> GAME ENDS HERE. "
506 TX$(LEN(TX$)+1)=A$
507 GOSUB 4000
520 INPUT #1,A$
525 TX$=A$:GOSUB 4000
540 CLOSE #1
545 TX$="MCP:> GAME RESTARTS - RESETING ALL":GOSUB 4000
546 TX$="      CONNECTIONS. PLEASE WAIT.":GOSUB 4000
547 FOR DL=1 TO 25:FOR W=1 TO 200:NEXT W:NEXT DL :REM CA. 25 SEK - GIBT DEM
548 REM WLAN-STACK ZEIT, DIE TCP-VERBINDUNG VOLLSTAENDIG ABZUBAUEN
550 RUN
700 REM -- GRACEFUL STOP: HICCUP AFTER GAME START --
710 TX$="MCP:> CONNECTION ENDED (CODE "
711 TX$(LEN(TX$)+1)=STR$(PEEK(195))
712 TX$(LEN(TX$)+1)=")"
713 GOSUB 4000
720 CLOSE #1
725 FOR DL=1 TO 25:FOR W=1 TO 200:NEXT W:NEXT DL
730 RUN
900 REM -- NETWORK / IO ERROR HANDLER (SETUP PHASE ONLY) --
910 TX$="MCP:> NETWORK ERROR, CODE "
911 TX$(LEN(TX$)+1)=STR$(PEEK(195))
912 GOSUB 4000
920 CLOSE #1
925 FOR DL=1 TO 25:FOR W=1 TO 200:NEXT W:NEXT DL
930 RUN
1000 REM -- SEND A MOVE COMMAND FOR DIRECTION DR --
1010 D$="MOVE U"
1020 IF DR=2 THEN D$="MOVE D"
1030 IF DR=3 THEN D$="MOVE L"
1040 IF DR=4 THEN D$="MOVE R"
1050 PRINT #1;D$
1060 RETURN
3000 REM -- ASCII-KUNST HOLEN, AUF 40 SPALTEN REDUZIERT ANZEIGEN. --
3001 REM    NUTZT FUJINETS N:HTTP-MODUS (AUX1=12, AUX2=0) - BESTAETIGT
3002 REM    DERSELBE KANAL #1 WIE FUERS SPIEL (STRENG NACHEINANDER: HIER
3003 REM    ERST GESCHLOSSEN, BEVOR DAS SPIEL SEINEN EIGENEN OPEN MACHT).
3010 AU$="N:HTTP://fotofix.classic-computing.de/"
3020 AU$(LEN(AU$)+1)=PIN$
3030 AU$(LEN(AU$)+1)="/ascii-terminal.txt"
3040 TRAP 3200
3041 RETRYCT=0
3050 OPEN #1,12,0,AU$
3055 FOR DL=1 TO 2:FOR W=1 TO 200:NEXT W:NEXT DL :REM kurze pause, damit die
3056 REM http-anfrage zeit hat wirklich anzukommen, bevor wir lesen
3060 KEEP=1:OC=0:SCCT=0:NB=0
3070 GET #1,BY
3071 NB=NB+1
3072 IF BY=0 THEN 3195 :REM nullbyte = ende der echten daten
3074 IF NB>2500 THEN 3195 :REM harte obergrenze - schutz vor endlosschleife
3080 IF BY=13 OR BY=10 THEN KEEP=1:SCCT=0:GOSUB 3300
3085 IF BY=13 OR BY=10 THEN GOTO 3190
3090 IF KEEP=0 THEN GOTO 3140
3100 IF BY=94 THEN BY=39 :REM '^' -> apostroph (auf anderen plattformen riskant)
3110 ? CHR$(BY);
3120 OC=OC+1:IF OC=40 THEN OC=0 :REM bildschirm wrapt bei spalte 40 schon
3121 REM         automatisch - kein zusaetzlicher newline noetig/gewollt
3140 KEEP=1-KEEP
3150 SCCT=SCCT+1:IF SCCT=80 THEN SCCT=0:KEEP=1
3190 IF ST=0 THEN 3070
3195 REM -- normal fertig (nullbyte, obergrenze, oder st<>0) --
3196 TRAP 40000
3197 IF NB<10 AND RETRYCT=0 THEN GOTO 3400
3198 GOTO 3210
3200 REM -- abbruch durch echten trap-fehler - einfach ueberspringen --
3202 TRAP 40000
3210 GOSUB 3300 :REM falls die letzte zeile noch offen war
3215 CLOSE #1
3220 RETURN
3300 REM -- newline drucken, aber nie doppelt hintereinander --
3310 IF OC=0 THEN RETURN
3320 ?
3330 OC=0
3340 RETURN
3400 REM -- einmaliger wiederholungsversuch, falls verdaechtig wenig ankam --
3410 GOSUB 3300
3420 CLOSE #1
3430 RETRYCT=1
3440 FOR DL=1 TO 5:FOR W=1 TO 200:NEXT W:NEXT DL
3450 TRAP 3200
3460 GOTO 3050
4000 REM -- TX$ MIT TERMINAL-TIPPEFFEKT AUSGEBEN (WIE DAS BILD: --
4001 REM    ZEICHENWEISE MIT KURZER PAUSE). NICHT FUER DEN TITEL. --
4010 FOR TI=1 TO LEN(TX$)
4020 ? TX$(TI,TI);
4030 FOR TW=1 TO 15:NEXT TW :REM tippgeschwindigkeit - kleiner=schneller
4040 NEXT TI
4050 ?
4060 RETURN
