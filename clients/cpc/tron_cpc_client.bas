10 REM RETRO TRON - SCHNEIDER CPC
11 REM SERVER DRAWS THE PLAYFIELD
12 REM THIS CPC ONLY STEERS - VIA
13 REM HTTP POLLING (M4). JOYSTICK
14 REM VIA JOY(0)
20 MODE 1
30 HO$="192.168.17.138" : REM <-- EDIT: SERVER IP
40 PO$="8080" : REM <-- EDIT: HTTP BRIDGE PORT (SEE SERVER STARTUP MESSAGE!)
50 NA$="SCHNEIDERCPC" : REM <-- EDIT: YOUR PLAYER NAME
60 BUF=&8000 : REM SCRATCH MEMORY FOR HTTP RESPONSES
70 BL=150 : REM KEPT SMALL (RESPONSES ARE NEVER LONGER) - SAVES POKE/PEEK TIME
80 REM -- RESTART POINT, REACHED VIA "RUN" (SEE BELOW) --
90 MODE 1
91 PRINT " RETRO TRON BATTLE -"
92 PRINT " CLASSIC COMPUTING 2026"
93 PRINT " SCHNEIDER CPC EDITION - BUILD 6"
94 PRINT
100 PRINT "ENTER YOUR PIN OR PRESS ENTER:"
110 INPUT PN$
120 IF PN$="" THEN PN$="NONE"
130 PRINT "CONNECTING..."
140 U$=HO$+":"+PO$+"/join/CPC/"+NA$+"/"+PN$
150 GOSUB 2000 : REM HTTP GET -> R$
160 IF LEFT$(R$,7)="SESSION" OR LEFT$(R$,7)="session" THEN 220
170 FOR DL=1 TO 3:FOR W=1 TO 2000:NEXT W:NEXT DL:GOTO 130
220 REM -- EXTRACT SESSION ID --
230 SP=1
240 IF MID$(R$,SP,1)=" " THEN 260
250 SP=SP+1:IF SP<=LEN(R$) THEN 240
260 SS=SP+1:SE=SS
270 IF SE>LEN(R$) THEN 300
280 IF MID$(R$,SE,1)=CHR$(10) OR MID$(R$,SE,1)=CHR$(13) THEN 300
290 SE=SE+1:GOTO 270
300 SN$=MID$(R$,SS,SE-SS)
310 GS=0
320 IF LEFT$(R$,5)="START" OR LEFT$(R$,5)="start" THEN 340
330 PRINT "WAITING FOR OPPONENT...":GOTO 400
340 PRINT "USE JOYSTICK":GS=1
400 REM ===== MAIN LOOP =====
405 DR$="N"
410 J=JOY(0)
420 ND$="N"
430 IF (J AND 1)<>0 THEN ND$="U"
440 IF (J AND 2)<>0 THEN ND$="D"
450 IF (J AND 4)<>0 THEN ND$="L"
460 IF (J AND 8)<>0 THEN ND$="R"
470 IF ND$<>"N" THEN DR$=ND$
480 U$=HO$+":"+PO$+"/tick/"+SN$+"/"+DR$
490 GOSUB 2000 : REM HTTP GET -> R$
500 IF R$="" THEN 400
520 IF LEFT$(R$,3)="ERR" OR LEFT$(R$,3)="err" THEN 800
530 IF GS=1 THEN 560
540 IF LEFT$(R$,5)<>"START" AND LEFT$(R$,5)<>"start" THEN 560
550 PRINT "USE JOYSTICK":GS=1
560 IF LEFT$(R$,3)<>"END" AND LEFT$(R$,3)<>"end" THEN 400
600 REM -- GAME OVER: SHOW RESULT, THEN RESTART --
610 PRINT "GAME OVER":PRINT R$
630 PRINT "RESTARTING..."
650 FOR DL=1 TO 3:FOR W=1 TO 2000:NEXT W:NEXT DL : REM ~3 SEC, ADJUST IF NEEDED
660 RUN
800 PRINT "RESTARTING...":RUN
2000 REM -- HTTP GET U$ -> R$ (M4, |HTTPMEM) --
2010 FOR ZI=0 TO BL-1
2020 POKE BUF+ZI,0
2030 NEXT ZI
2040 |HTTPMEM,U$,BUF,BL
2050 R$=""
2060 FOR ZI=0 TO BL-1
2070 BY=PEEK(BUF+ZI)
2080 IF BY=0 THEN 2110
2090 R$=R$+CHR$(BY)
2100 NEXT ZI
2110 RETURN
