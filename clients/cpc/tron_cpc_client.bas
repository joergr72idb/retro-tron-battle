10 REM RETRO TRON - SCHNEIDER CPC
11 REM SERVER DRAWS THE PLAYFIELD
12 REM THIS CPC ONLY STEERS - VIA
13 REM HTTP POLLING (M4). JOYSTICK
14 REM VIA JOY(0)
20 MODE 1
30 HO$="192.168.17.138" : REM <-- EDIT: SERVER IP
40 PO$="8080" : REM <-- EDIT: HTTP BRIDGE PORT (SEE SERVER STARTUP MESSAGE!)
50 NA$="SCHNEIDERCPC" : REM <-- EDIT: YOUR PLAYER NAME
60 BUF=&8000 : REM SCRATCH MEMORY FOR HTTP RESPONSES
70 BL=150 : REM KEPT SMALL (RESPONSES ARE NEVER LONGER) - SAVES POKE/PEEK TIME
75 SV=0:SW=54000 : REM SCREEN SAVER DELAY IN 1/300 S (54000 = 3 MIN), SEE 5000
80 REM -- RESTART POINT, REACHED VIA "RUN" (SEE BELOW) --
85 GOSUB 5300 : REM INKS BACK ON IN CASE WE RESTARTED WITH THE SCREEN SAVER ACTIVE
90 MODE 1
91 PRINT " RETRO TRON BATTLE -"
92 PRINT " CLASSIC COMPUTING 2026"
93 PRINT " SCHNEIDER CPC EDITION - BUILD 9"
94 PRINT
95 REM -- FLUSH KEY BUFFER: THE JOYSTICK IS PART OF THE KEY MATRIX, SO
96 REM    STEERING DURING THE MATCH LEAVES ARROW CHARS QUEUED, WHICH
97 REM    WOULD OTHERWISE LAND IN THE PIN PROMPT AFTER "RUN"
98 WHILE INKEY$<>"":WEND
100 PRINT "ENTER YOUR PIN OR PRESS ENTER:"
110 GOSUB 5000 : REM PIN INPUT WITH SCREEN SAVER -> PN$
120 IF PN$="" THEN PN$="NONE"
130 PRINT "CONNECTING..."
140 U$=HO$+":"+PO$+"/join/CPC/"+NA$+"/"+PN$
150 GOSUB 2000 : REM HTTP GET -> R$
160 IF LEFT$(R$,7)="SESSION" OR LEFT$(R$,7)="session" THEN 220
170 FOR DL=1 TO 3:FOR W=1 TO 2000:NEXT W:NEXT DL:GOTO 130
220 REM -- EXTRACT SESSION ID --
230 SP=1
240 IF MID$(R$,SP,1)=" " THEN 260
250 SP=SP+1:IF SP<=LEN(R$) THEN 240
260 SS=SP+1:SE=SS
270 IF SE>LEN(R$) THEN 300
280 IF MID$(R$,SE,1)=CHR$(10) OR MID$(R$,SE,1)=CHR$(13) THEN 300
290 SE=SE+1:GOTO 270
300 SN$=MID$(R$,SS,SE-SS)
301 REM -- R$ STILL STARTS WITH "SESSION <ID>" HERE - RS$ IS WHATEVER
302 REM    CAME AFTER THAT LINE, WHICH IS WHAT ACTUALLY NEEDS CHECKING
303 REM    BELOW (A SECOND PLAYER CAN GET AN INSTANT "START ..." EMBEDDED
304 REM    RIGHT IN THE JOIN RESPONSE, NOT JUST "WAIT")
305 RS$="":IF SE<=LEN(R$) THEN RS$=MID$(R$,SE+1,LEN(R$)-SE)
310 GS=0:T0=TIME
320 IF LEFT$(RS$,5)="START" OR LEFT$(RS$,5)="start" THEN 340
330 PRINT "WAITING FOR OPPONENT...":GOTO 400
340 PRINT "USE JOYSTICK":GS=1
400 REM ===== MAIN LOOP =====
405 DR$="N"
410 J=JOY(0)
420 ND$="N"
430 IF (J AND 1)<>0 THEN ND$="U"
440 IF (J AND 2)<>0 THEN ND$="D"
450 IF (J AND 4)<>0 THEN ND$="L"
460 IF (J AND 8)<>0 THEN ND$="R"
470 IF ND$<>"N" THEN DR$=ND$
480 U$=HO$+":"+PO$+"/tick/"+SN$+"/"+DR$
490 GOSUB 2000 : REM HTTP GET -> R$
500 IF R$="" THEN 400
520 IF LEFT$(R$,3)="ERR" OR LEFT$(R$,3)="err" THEN 800
530 IF GS=1 THEN 560
540 IF LEFT$(R$,5)="START" OR LEFT$(R$,5)="start" THEN 550
541 REM -- STILL WAITING FOR AN OPPONENT: SCREEN SAVER HERE TOO (SEE 5000),
542 REM    LIFTED BY ANY KEY/JOYSTICK MOVE OR AUTOMATICALLY ON START --
543 IF INKEY$<>"" THEN T0=TIME:IF SV=1 THEN GOSUB 5300
544 IF SV=0 AND TIME-T0>SW THEN GOSUB 5200
545 GOTO 560
550 IF SV=1 THEN GOSUB 5300
555 PRINT "USE JOYSTICK":GS=1
560 IF LEFT$(R$,3)<>"END" AND LEFT$(R$,3)<>"end" THEN 400
600 REM -- GAME OVER: SHOW RESULT, THEN RESTART --
610 PRINT "GAME OVER":PRINT R$
630 PRINT "RESTARTING..."
650 FOR DL=1 TO 3:FOR W=1 TO 2000:NEXT W:NEXT DL : REM ~3 SEC, ADJUST IF NEEDED
660 RUN
800 PRINT "RESTARTING...":RUN
2000 REM -- HTTP GET U$ -> R$ (M4, |HTTPMEM) --
2010 FOR ZI=0 TO BL-1
2020 POKE BUF+ZI,0
2030 NEXT ZI
2040 |HTTPMEM,U$,BUF,BL
2050 R$=""
2060 FOR ZI=0 TO BL-1
2070 BY=PEEK(BUF+ZI)
2080 IF BY=0 THEN 2110
2090 R$=R$+CHR$(BY)
2100 NEXT ZI
2110 RETURN
5000 REM -- PIN INPUT WITH SCREEN SAVER -> PN$. REPLACES A PLAIN INPUT
5001 REM    SO WE CAN WATCH THE CLOCK: AFTER SW (1/300 S) WITHOUT A KEY
5002 REM    THE SCREEN GOES BLACK TO SAVE THE MONOCHROME CRT FROM BURN-IN.
5003 REM    ANY KEY WAKES IT - THAT KEY IS SWALLOWED, NOT TYPED INTO THE PIN --
5010 PN$="":T0=TIME:PRINT "? ";
5020 K$=INKEY$
5030 IF K$<>"" THEN 5060
5040 IF SV=0 AND TIME-T0>SW THEN GOSUB 5200
5050 GOTO 5020
5060 T0=TIME:IF SV=1 THEN GOSUB 5300:GOTO 5020
5070 K=ASC(K$)
5080 IF K=13 THEN PRINT:RETURN
5090 IF K=127 AND LEN(PN$)>0 THEN PN$=LEFT$(PN$,LEN(PN$)-1):PRINT CHR$(8);" ";CHR$(8);:GOTO 5020
5100 IF K<32 OR K>126 OR LEN(PN$)>=20 THEN 5020 : REM IGNORES JOYSTICK/CURSOR CODES TOO
5110 PN$=PN$+K$:PRINT K$;:GOTO 5020
5200 REM -- SCREEN SAVER ON: ALL INKS + BORDER BLACK (SCREEN RAM UNTOUCHED) --
5210 INK 0,0:INK 1,0:INK 2,0:INK 3,0:BORDER 0:SV=1:RETURN
5300 REM -- SCREEN SAVER OFF: MODE 1 DEFAULT INKS BACK, DROP QUEUED KEYS --
5310 INK 0,1:INK 1,24:INK 2,20:INK 3,6:BORDER 1:SV=0
5320 WHILE INKEY$<>"":WEND:RETURN
