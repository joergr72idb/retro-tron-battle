10 REM RETRO TRON - SCHNEIDER CPC
11 REM SERVER ZEICHNET DAS SPIELFELD
12 REM DIESER CPC STEUERT NUR - PER
13 REM HTTP-POLLING (M4). JOYSTICK
14 REM UEBER JOY(0)
20 MODE 1
30 HO$="192.168.17.158" : REM <-- EDIT: SERVER IP
40 PO$="8080" : REM <-- EDIT: HTTP-BRIDGE-PORT (SIEHE SERVER-STARTMELDUNG!)
50 NA$="SCHNEIDERCPC" : REM <-- EDIT: DEIN SPIELERNAME
60 BUF=&8000 : REM SCRATCH-SPEICHER FUER HTTP-ANTWORTEN
70 BL=150 : REM KLEIN GEHALTEN (ANTWORTEN SIND NIE LAENGER) - SPART POKE/PEEK-ZEIT
80 REM -- NEUSTART-PUNKT --
90 MODE 1
91 PRINT " RETRO TRON BATTLE -"
92 PRINT " CLASSIC COMPUTING 2026"
93 PRINT " SCHNEIDER CPC EDITION - BUILD 4"
94 PRINT
100 TX$="MCP:> WELCOME TO THE GRID...":GOSUB 4000
101 TX$="MCP:> USER ENTER YOUR PIN (OR ENTER":GOSUB 4000
102 TX$="      FOR MOVEON WITHOUT):":GOSUB 4000
110 INPUT PN$
120 IF PN$="" THEN PN$="NONE"
121 IF PN$="NONE" THEN 130
122 TX$="MCP:> MASTER CONTROL PROGRAM SEARCH PHOTO...":GOSUB 4000
123 TX$="MCP:> DOWNLOAD PHOTO FROM FOTOFIX-SERVER -":GOSUB 4000
124 TX$="      UPLOAD TO GRID":GOSUB 4000
125 GOSUB 3000 : REM ascii-kunst holen und anzeigen
126 FOR DL=1 TO 5:FOR W=1 TO 2000:NEXT W:NEXT DL : REM ca. 5 sek pause
130 TX$="MCP:> UPLOAD COMPLETED. CONNECTING GRIDSERVER "+HO$+":"+PO$:GOSUB 4000
140 U$=HO$+":"+PO$+"/join/CPC/"+NA$+"/"+PN$
150 GOSUB 2000 : REM HTTP GET -> R$
155 TX$="MCP:> YOU'VE GRANTED ACCESS TO THE GAME GRID":GOSUB 4000
170 REM -- SESSION-ID EXTRAHIEREN --
180 SP=1
190 IF MID$(R$,SP,1)=" " THEN 210
200 SP=SP+1:IF SP<=LEN(R$) THEN 190
210 SS=SP+1:SE=SS
220 IF SE>LEN(R$) THEN 250
230 IF MID$(R$,SE,1)=CHR$(10) OR MID$(R$,SE,1)=CHR$(13) THEN 250
240 SE=SE+1:GOTO 220
250 SN$=MID$(R$,SS,SE-SS)
270 GS=0
280 IF LEFT$(R$,5)="START" OR LEFT$(R$,5)="start" THEN 300
290 GOTO 400
300 TX$="MCP:> GET READY FOR RACE. USE JOYSTICK.":GOSUB 4000
301 TX$="      WATCH ON GRID SCREEN":GOSUB 4000
302 GS=1
400 REM ===== HAUPTSCHLEIFE =====
405 DR$="N"
410 J=JOY(0)
420 ND$="N"
430 IF (J AND 1)<>0 THEN ND$="U"
440 IF (J AND 2)<>0 THEN ND$="D"
450 IF (J AND 4)<>0 THEN ND$="L"
460 IF (J AND 8)<>0 THEN ND$="R"
470 IF ND$<>"N" THEN DR$=ND$
480 U$=HO$+":"+PO$+"/tick/"+SN$+"/"+DR$
490 GOSUB 2000 : REM HTTP GET -> R$
500 IF R$="" THEN 400
520 IF LEFT$(R$,3)="ERR" OR LEFT$(R$,3)="err" THEN 800
530 IF GS=1 THEN 560
540 IF LEFT$(R$,5)<>"START" AND LEFT$(R$,5)<>"start" THEN 560
550 TX$="MCP:> GET READY FOR RACE. USE JOYSTICK.":GOSUB 4000
551 TX$="      WATCH ON GRID SCREEN":GOSUB 4000
552 GS=1
560 IF LEFT$(R$,3)<>"END" AND LEFT$(R$,3)<>"end" THEN 400
600 REM -- SPIEL ZU ENDE: ERGEBNIS ZEIGEN, DANN NEUSTART --
610 TX$="MCP:> GAME ENDS HERE. "+R$:GOSUB 4000
630 TX$="MCP:> GAME RESTARTS - RESETING ALL":GOSUB 4000
631 TX$="      CONNECTIONS. PLEASE WAIT.":GOSUB 4000
650 FOR DL=1 TO 10:FOR W=1 TO 2000:NEXT W:NEXT DL
660 GOTO 90
800 TX$="MCP:> SESSION ENDED - RESTARTING...":GOSUB 4000:GOTO 90
2000 REM -- HTTP GET U$ -> R$ (M4, |HTTPMEM) --
2010 FOR ZI=0 TO BL-1
2020 POKE BUF+ZI,0
2030 NEXT ZI
2040 |HTTPMEM,U$,BUF,BL
2050 R$=""
2060 FOR ZI=0 TO BL-1
2070 BY=PEEK(BUF+ZI)
2080 IF BY=0 THEN 2110
2090 R$=R$+CHR$(BY)
2100 NEXT ZI
2110 RETURN
3000 REM -- ASCII-KUNST HOLEN, ZEICHENWEISE AUF 40 SPALTEN REDUZIERT
3001 REM    ANZEIGEN (80X24 -> 40X24, JEDES 2. ZEICHEN, ^ ERSETZT) --
3010 AU$="fotofix.classic-computing.de/"+PN$+"/ascii-terminal.txt"
3020 ABUF=&8200:ABL=2000 : REM eigener, groesserer puffer als der normale
3030 FOR ZI=0 TO ABL-1:POKE ABUF+ZI,0:NEXT ZI
3040 |HTTPMEM,AU$,ABUF,ABL
3050 SC=0:OC=0
3060 FOR ZI=0 TO ABL-1
3070 BY=PEEK(ABUF+ZI)
3080 IF BY=0 THEN 3160
3090 IF BY=13 OR BY=10 THEN SC=0:IF OC>0 THEN PRINT:OC=0
3095 IF BY=13 OR BY=10 THEN 3150
3100 IF (SC AND 1)<>0 THEN 3140
3110 IF BY=94 THEN BY=39 : REM 94='^' - petscii/cpc-riskant, 39=apostroph
3120 PRINT CHR$(BY);
3130 OC=OC+1:IF OC=40 THEN PRINT:OC=0
3140 SC=SC+1:IF SC=80 THEN SC=0
3150 NEXT ZI
3160 IF OC>0 THEN PRINT
3170 RETURN
4000 REM -- TX$ MIT TERMINAL-TIPPEFFEKT AUSGEBEN (WIE DAS BILD) --
4010 FOR TI=1 TO LEN(TX$)
4020 PRINT MID$(TX$,TI,1);
4030 FOR TW=1 TO 60:NEXT TW : REM TIPPGESCHWINDIGKEIT - KLEINER=SCHNELLER
4040 NEXT TI
4050 PRINT
4060 RETURN
