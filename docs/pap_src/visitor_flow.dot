digraph visitor_flow {
  rankdir=TB;
  bgcolor="white";
  fontname="Helvetica";
  labelloc="t";
  fontsize=20;
  label="Retro Tron Battle — Visitor Flow (PAP)\n\n";
  node [fontname="Helvetica", fontsize=12, margin="0.15,0.1"];
  edge [fontname="Helvetica", fontsize=10];
  nodesep=0.5;
  ranksep=0.35;

  start   [label="START\n(retro computer powered on,\nclient program running)", shape=box, style="rounded,filled", fillcolor="#dbe7f7"];
  pin     [label="Enter visitor PIN\n(or press ENTER to skip)", shape=parallelogram, style=filled, fillcolor="#fdf1cf"];
  connect [label="Client connects to the server\nover the computer's WiFi add-on\n(FujiNet / Meatloaf / M4)", shape=box, style=filled, fillcolor="#ffffff"];
  wait_dec [label="Opponent\nalready waiting?", shape=diamond, style=filled, fillcolor="#dff2e1"];
  show_wait [label="Show\n\"WAITING FOR OPPONENT...\"", shape=parallelogram, style=filled, fillcolor="#fdf1cf"];
  countdown [label="Countdown on the big screen:\n3, 2, 1, GO!", shape=box, style=filled, fillcolor="#ffffff"];
  steer   [label="Steer with the joystick\n(up / down / left / right)", shape=parallelogram, style=filled, fillcolor="#fdf1cf"];
  crash_dec [label="Wall, own trail, or\nopponent's trail hit\n(by either player)?", shape=diamond, style=filled, fillcolor="#dff2e1"];
  result_dec [label="Exactly one\nplayer crashed?", shape=diamond, style=filled, fillcolor="#dff2e1"];
  show_win [label="Show \"<PLATFORM> WINS!\"\n+ winner's photo + updated score", shape=parallelogram, style=filled, fillcolor="#fdf1cf"];
  show_draw [label="Show \"DRAW —\nSIMULTANEOUS CRASH!\"\n+ updated score", shape=parallelogram, style=filled, fillcolor="#fdf1cf"];
  restart [label="Client restarts itself,\nready for the next visitor", shape=box, style=filled, fillcolor="#ffffff"];
  end_    [label="END\n(back to START)", shape=box, style="rounded,filled", fillcolor="#dbe7f7"];

  start -> pin -> connect -> wait_dec;
  wait_dec -> show_wait [label="no"];
  show_wait -> wait_dec [label="  keeps polling"];
  wait_dec -> countdown [label="yes"];
  countdown -> steer;
  steer -> crash_dec;
  crash_dec -> steer [label="no", tailport=w, headport=w];
  crash_dec -> result_dec [label="yes"];
  result_dec -> show_win [label="yes"];
  result_dec -> show_draw [label="no, both did"];
  show_win -> restart;
  show_draw -> restart;
  restart -> end_;

  subgraph cluster_legend {
    label="PAP symbols";
    fontsize=11;
    style=filled;
    fillcolor="#f7f7f7";
    color="#999999";
    l_term [label="Start / End", shape=box, style="rounded,filled", fillcolor="#dbe7f7", fontsize=10, width=1.3, height=0.4];
    l_proc [label="Process step", shape=box, fillcolor="#ffffff", style=filled, fontsize=10, width=1.3, height=0.4];
    l_io   [label="Screen output /\njoystick input", shape=parallelogram, style=filled, fillcolor="#fdf1cf", fontsize=10, width=1.3, height=0.4];
    l_dec  [label="Decision", shape=diamond, style=filled, fillcolor="#dff2e1", fontsize=10, width=1.3, height=0.5];
    l_term -> l_proc -> l_io -> l_dec [style=invis];
  }
}
